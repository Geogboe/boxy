# Routine repository validation is exposed through these Taskfile entrypoints.
# Keep deployment, cleanup, and arbitrary shell/Go commands approval-gated.
prefix_rule(pattern=["task", "fmt"], decision="allow")
prefix_rule(pattern=["task", "generate"], decision="allow")
prefix_rule(pattern=["task", "lint"], decision="allow")
prefix_rule(pattern=["task", "test"], decision="allow")
prefix_rule(pattern=["task", "ci:validate"], decision="allow")
prefix_rule(pattern=["task", "agent:test:all"], decision="allow")
prefix_rule(pattern=["task", "agent:test:cli"], decision="allow")
prefix_rule(pattern=["task", "agent:test:pool"], decision="allow")
prefix_rule(pattern=["task", "agent:test:providers"], decision="allow")
prefix_rule(pattern=["task", "agent:test:server"], decision="allow")
prefix_rule(pattern=["task", "agent:test:execution"], decision="allow")
prefix_rule(pattern=["task", "agent:test:psdirect"], decision="allow")
prefix_rule(pattern=["task", "agent:e2e:serve"], decision="allow")
prefix_rule(pattern=["task", "agent:generate"], decision="allow")
prefix_rule(pattern=["task", "agent:test:race"], decision="allow")
prefix_rule(pattern=["task", "agent:ci:validate"], decision="allow")
