{
  "$id": "boxy://schemas/boxy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact_stores": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "access_key": {
            "pattern": "^env:.+",
            "type": "string"
          },
          "bucket": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "secret_key": {
            "pattern": "^env:.+",
            "type": "string"
          },
          "type": {
            "enum": [
              "local",
              "filesystem",
              "s3"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "packages": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "defaults": {
            "type": "object"
          },
          "events": {
            "items": {
              "enum": [
                "provision",
                "promotion",
                "allocation"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "inputs": {
            "type": "object"
          },
          "method": {
            "enum": [
              "shell",
              "powershell",
              "dsc",
              "ansible"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "items": {
              "enum": [
                "resource",
                "allocation"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "version",
          "method",
          "scopes",
          "events"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "pools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "description": "Optional agent instance ID this pool is pinned to.",
            "type": "string"
          },
          "config": {
            "description": "Provider/pool-type-specific configuration.",
            "type": "object"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "packages": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "policies": {
            "additionalProperties": false,
            "description": "\"policy\" and \"policies\" are aliases for the same setting and are mutually exclusive — set only one.",
            "properties": {
              "preheat": {
                "additionalProperties": false,
                "properties": {
                  "max_total": {
                    "description": "Maximum total resources for this pool. 0 is a deliberate, valid value meaning \"drain\" (stop preheating and let the pool empty), not an omission.",
                    "type": "integer"
                  },
                  "min_ready": {
                    "description": "Minimum number of pre-provisioned ready resources to maintain.",
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "recycle": {
                "additionalProperties": false,
                "properties": {
                  "max_age": {
                    "description": "Maximum resource age before recycling, as a Go duration string (e.g. \"1h\").",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "policy": {
            "additionalProperties": false,
            "description": "\"policy\" and \"policies\" are aliases for the same setting and are mutually exclusive — set only one.",
            "properties": {
              "preheat": {
                "additionalProperties": false,
                "properties": {
                  "max_total": {
                    "description": "Maximum total resources for this pool. 0 is a deliberate, valid value meaning \"drain\" (stop preheating and let the pool empty), not an omission.",
                    "type": "integer"
                  },
                  "min_ready": {
                    "description": "Minimum number of pre-provisioned ready resources to maintain.",
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "recycle": {
                "additionalProperties": false,
                "properties": {
                  "max_age": {
                    "description": "Maximum resource age before recycling, as a Go duration string (e.g. \"1h\").",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "provider": {
            "description": "Optional provider instance name. Some pool types (like \"docker\") may imply a default provider.",
            "type": "string"
          },
          "source": {
            "description": "Immutable resource source name.",
            "type": "string"
          },
          "template": {
            "description": "Reusable resource template name.",
            "type": "string"
          },
          "type": {
            "description": "Pool kind. \"\" and \"container\" and \"docker\" all resolve to a container pool.",
            "enum": [
              "",
              "container",
              "docker",
              "vm",
              "share"
            ],
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "providers": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "devfactory"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "$ref": "providers/devfactory.config.schema.json"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "docker"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "$ref": "providers/docker.config.schema.json"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "hyperv"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "$ref": "providers/hyperv.config.schema.json"
                }
              }
            }
          }
        ],
        "properties": {
          "config": {
            "type": "object"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "devfactory",
              "docker",
              "hyperv"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "server": {
      "additionalProperties": false,
      "properties": {
        "agent_heartbeat_interval": {
          "description": "How often connected remote agents send heartbeats, as a Go duration string (e.g. \"15s\"). Empty means the default (15s).",
          "type": "string"
        },
        "grpc_cert_sans": {
          "description": "Extra DNS names/IPs to include in the agent gRPC server certificate's SANs, on top of the always-included localhost/127.0.0.1/listen-host entries. Needed when remote agents connect through a passthrough route or load balancer using an external DNS name. Equivalent repeatable CLI flag: --grpc-cert-san (fully overrides this value when passed).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "grpc_listen": {
          "description": "Agent-transport gRPC listen address (see docs/adr/0005-remote-agent-transport-and-registration.md). Empty means the default (:9091).",
          "type": "string"
        },
        "listen": {
          "description": "HTTP API listen address. Empty means the default (:9090).",
          "type": "string"
        },
        "providers": {
          "description": "Provider instance names to expose via the API/UI (subset of the top-level providers list).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "secrets": {
          "additionalProperties": false,
          "description": "Explicit server-owned secret backend. Required for guest-personalizable pools; there is no automatic fallback.",
          "properties": {
            "backend": {
              "description": "Secret backend: file for ACL/mode-protected portable deployments, keyring for local OS keychains, or dpapi for Windows machine-scope protection.",
              "enum": [
                "file",
                "keyring",
                "dpapi"
              ],
              "type": "string"
            },
            "path": {
              "description": "Backend file path for file or dpapi. Relative paths are resolved beside .boxy/state.json.",
              "type": "string"
            },
            "service": {
              "description": "Optional OS keyring service name for the keyring backend.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "ui": {
          "description": "Whether the web dashboard is served alongside the API. Default: true.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "sources": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-fA-F]{64}$",
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "os": {
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "store": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "store",
          "path",
          "digest"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "templates": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string"
          },
          "config": {
            "type": "object"
          },
          "extends": {
            "type": "string"
          },
          "packages": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "provider": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "type": {
            "enum": [
              "",
              "container",
              "docker",
              "vm",
              "share"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "object"
    }
  },
  "title": "Boxy Configuration",
  "type": "object"
}
